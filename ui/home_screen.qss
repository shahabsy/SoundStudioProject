
QWidget {
    background-color: #1e1e1e;
    color: #f55555;
    font-family: "Segoe UI"
    font-size: 12px;
}

QPushButton {
    background-color: #3a3a3a;
    color: #ffffff;
    border-radius: 5px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #505050;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

QLineEdit {
    background-color: #2a2a2a;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px;
    color: #ffffff
}

QListView {
    background-color: #2a2a2a;
    border: 1px solid #444444;
    padding: 5px;
    color: #ffffff;

}

QListView:item:selected {
    background-color: #2a2a2a;
    color: #ffcc00;
}

QLabel {
    color: #dddddd;
}