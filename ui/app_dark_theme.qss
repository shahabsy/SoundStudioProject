QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI"
    font-size: 10pt;
}

QpushButton {
    background-color: #2c2c2c;
    color: white;
    border: 1px solid #444;
    padding: 6px;
    border-radius: 4px;
}

QpushButton:hover {
    background-color: #3c3c3c;
}

QListView {
    background-color: #2b2b2b;
    border: 1px solid #444;
    padding: 5px;
}

QScrollBar:vertical {
    background: #333;
    width: 10px;
    margin: 0px;
}